# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/
.DS_Store

# Credentials: keys are read from environment variables only
.env
.env.*
!.env.example
*.key
credentials*.json

# Work products: generated images, models, renders, videos, print files
outputs/
work/
workdir*/
.local/
*.log
*.png
*.jpg
*.jpeg
*.webp
*.glb
*.gltf
*.fbx
*.obj
*.stl
*.3mf
*.ply
*.blend
*.blend1
*.mp4
*.mov
*.webm

# Small synthetic fixtures generated by tests are written to tmp dirs, never committed.
# Documentation images, if any, must be original and live under docs/images/.
!docs/images/*.png
!docs/images/*.jpg
